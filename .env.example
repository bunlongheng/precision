# Precision - environment variables
# Auth is OPTIONAL. Leave these unset and the app runs open (no sign-in).
# Set them to lock the app to a single Google account (owner-only).

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: https://precision-bheng.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random 32+ char secret used to encrypt sessions. Generate: openssl rand -base64 32
AUTH_SECRET=

# Only this email may sign in. Everyone else is rejected at the Google callback.
AUTH_OWNER_EMAIL=you@example.com
