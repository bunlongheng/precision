# Precision - environment variables
# Auth is OPTIONAL. Leave everything unset and the app runs open (no sign-in).
# Set ONE of the gates below to lock the app to the owner.

# Passcode gate: set a shared secret and the app shows an unlock screen.
AUTH_ACCESS_CODE=

# --- OR: Google sign-in gate (locked to AUTH_OWNER_EMAIL) ---

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: https://precision-bheng.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Random 32+ char secret used to encrypt sessions. Generate: openssl rand -base64 32
AUTH_SECRET=

# Only this Google account may sign in (set it to your own address).
# Everyone else is rejected at the Google callback.
AUTH_OWNER_EMAIL=
